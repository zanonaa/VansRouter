# VansRouter — backend Go + SPA (migration/go-backend)
# cp .env.example .env; defina INITIAL_PASSWORD; docker compose up -d
# A imagem Dev abaixo é ARM64 e a tag é mutável. Para AMD64, faça build local
# e use VANSROUTER_IMAGE=vansrouter:go-local. Não é uma release oficial.
VANSROUTER_IMAGE=ghcr.io/zanonaa/vansrouter:dev-go-arm64

# Endereço e porta PUBLICADOS pelo Compose. Go escuta em 20128 no container.
BIND_ADDRESS=127.0.0.1
PORT=20128

# Senha inicial apenas para instalações novas. Substitua por valor forte.
INITIAL_PASSWORD=
NODE_ENV=production

# Docker: mantenha /app/data e preserve o volume existente.
# Execução nativa: defina um caminho absoluto de sua escolha.
DATA_DIR=/app/data
# SPA_DIR é /app/spa na imagem. Execução nativa: caminho para frontend/dist.
# SPA_DIR=/caminho/para/frontend/dist

# Omitidos/vazios: segredos gerados e persistidos em DATA_DIR.
JWT_SECRET=
API_KEY_SECRET=
# Ative quando o dashboard for servido por HTTPS.
AUTH_COOKIE_SECURE=false

# Headroom opcional: docker compose --profile headroom up -d
# Habilite também a integração no dashboard. RTK independe deste serviço.
HEADROOM_URL=http://headroom:8787
HEADROOM_PORT=8787

# Diagnóstico: desliga o Tool Call Guard globalmente, se necessário.
# VANSROUTER_TOOL_GUARD=off
# Proteção de dados: DATA_DIR temporário é recusado em produção, salvo opt-in.
# DATA_DIR_ALLOW_TEMP=1

# Proxy HTTP de saída (opcional; configurações por conexão ficam no dashboard).
# HTTP_PROXY=http://proxy:8080
# HTTPS_PROXY=http://proxy:8080
# NO_PROXY=localhost,127.0.0.1
