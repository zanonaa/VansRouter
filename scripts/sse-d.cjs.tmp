const { chromium } = require("playwright-core");
(async () => {
  const browser = await chromium.launch({ executablePath: "/usr/bin/chromium-browser", args: ["--no-sandbox"] });
  const page = await browser.newPage();
  await page.goto("http://localhost:20129/masuk", { waitUntil: "load", timeout: 60000 });
  await page.waitForSelector("input[type='password']", { timeout: 20000 });
  await page.fill("input[type='password']", "Smoke-Test-2026!Strong");
  await page.click("button[type='submit']");
  await page.waitForURL("**/dashboard**", { timeout: 30000 });
  const result = await page.evaluate(async () => {
    const res = await fetch("/api/translator/console-logs/stream");
    const ct = res.headers.get("content-type");
    let first = "";
    try {
      const reader = res.body.getReader();
      const { value } = await Promise.race([
        reader.read(),
        new Promise((r) => setTimeout(() => r({ value: null }), 5000)),
      ]);
      first = value ? new TextDecoder().decode(value.slice(0, 120)) : "(timeout sem chunk)";
      reader.cancel();
    } catch (e) {
      first = "erro: " + e.message;
    }
    return { status: res.status, ct, first };
  });
  console.log(JSON.stringify(result, null, 1));
  await browser.close();
})();
